# Copy this file to .env and fill in your IBM Cloud / watsonx.ai credentials.
# .env is gitignored; never commit real credentials.

# Required for natural-language explanations via Granite.
# If these are not set, the API falls back to a templated explanation.

WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-2-2b-instruct

# Path inside the container where artifacts are mounted.
# Override only if you mount somewhere unusual.
ARTIFACTS_DIR=/app/artifacts
